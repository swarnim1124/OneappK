<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- xsc_auth_prefs holds the encrypted JWT access/refresh token pair (see
         sdk/XscAuthSDK TokenManager/AuthModule) - excluded from both cloud backup
         and device-to-device transfer so session credentials never leave the
         device through either channel. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="xsc_auth_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="xsc_auth_prefs.xml" />
    </device-transfer>
</data-extraction-rules>