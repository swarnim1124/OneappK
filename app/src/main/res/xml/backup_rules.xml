<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- xsc_auth_prefs holds the encrypted JWT access/refresh token pair (see
         sdk/XscAuthSDK TokenManager/AuthModule) - excluded so a device backup or
         transfer never carries session credentials to another device. -->
    <exclude domain="sharedpref" path="xsc_auth_prefs.xml" />
</full-backup-content>