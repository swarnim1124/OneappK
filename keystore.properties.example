# Copy this file to `keystore.properties` (repo root, already gitignored) and fill in
# real values, OR set the equivalent RELEASE_* environment variables in CI - either
# works, see app/build.gradle.kts. Never commit the filled-in version of this file or
# the .keystore it points to.

storeFile=/absolute/or/root-relative/path/to/release.keystore
storePassword=
keyAlias=
keyPassword=
