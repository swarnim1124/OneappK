<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Used only by RazorpayCheckoutActivity, which draws nothing of its own: the
         Razorpay sheet animates up over whatever screen launched it. Without a
         translucent theme the user sees a white activity for a beat first. -->
    <style name="Theme.OneApp.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
