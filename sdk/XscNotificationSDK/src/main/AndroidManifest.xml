<?xml version="1.0" encoding="utf-8"?>
<!-- Declared here (not in :app) so the module that owns FCM also owns its own
     manifest wiring - the manifest merger pulls both into the final APK manifest,
     same precedent as INTERNET living in :sdk:XscNetworkSDK's manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required on API 33+ to post any notification, including this module's own
         FCM-triggered ones - see OneAppFirebaseMessagingService's runtime check,
         since the manifest declaration alone does not imply the user granted it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".OneAppFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
